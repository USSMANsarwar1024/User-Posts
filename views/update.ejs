<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit Post</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-gradient-to-br from-zinc-900 via-zinc-800 to-zinc-900 text-white flex items-center justify-center px-4">

  <div class="w-full max-w-2xl bg-zinc-950/70 backdrop-blur-sm border border-zinc-800 rounded-2xl shadow-2xl p-10">
    
    <!-- Header -->
    <div class="flex items-center justify-between mb-8">
      <h1 class="text-3xl font-bold text-yellow-400">✏️ Edit Your Post</h1>
      <a href="/logout" class="text-sm text-red-400 hover:text-red-300 bg-red-900/30 hover:bg-red-900/50 rounded-md px-3 py-1 transition-all duration-200">
        Logout
      </a>
    </div>

    <!-- Edit Form -->
    <form action="/update/<%= post._id %>" method="POST" class="space-y-6">
      <div>
        <label for="content" class="block text-sm font-semibold mb-2 text-zinc-300">
          Update your thoughts
        </label>
        <textarea
          id="content"
          name="content"
          autofocus
          rows="6"
          placeholder="What's on your mind?"
          class="w-full bg-zinc-800/80 border border-zinc-700 focus:border-yellow-400 rounded-xl p-4 resize-none text-zinc-100 outline-none placeholder-zinc-500 transition-all duration-200"
        ><%= post.content %></textarea>
      </div>

      <div class="flex justify-end">
        <input
          type="submit"
          value="💾 Update Post"
          class="cursor-pointer bg-yellow-400 hover:bg-yellow-300 text-black font-semibold px-6 py-2 rounded-xl shadow-md hover:shadow-yellow-400/30 transition-all duration-200"
        />
      </div>
    </form>

    <!-- Back Link -->
    <div class="mt-8 flex justify-between items-center">
      <a href="/profile" class="text-zinc-400 hover:text-yellow-400 transition-all duration-200">
        ← Back to Profile
      </a>
      <p class="text-xs text-zinc-600 italic">
        Last updated on <%= new Date(post.date).toLocaleDateString() %>
      </p>
    </div>

  </div>

</body>
</html>
